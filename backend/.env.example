PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/mern_admin
MONGO_DB_NAME=mern_admin
JWT_SECRET=replace_with_a_random_secret_at_least_32_characters_long
JWT_EXPIRES_IN=1d
CLIENT_URL=http://localhost:5173
NODE_ENV=development

# Password reset email (required in production)
PASSWORD_RESET_URL=http://localhost:5173
EMAIL_API_URL=https://api.resend.com/emails
EMAIL_API_KEY=your-email-provider-api-key
EMAIL_FROM=no-reply@example.com

# Optional local seed users. SEED_ADMIN_PASSWORD is required when NODE_ENV=production.
SEED_ADMIN_NAME=Admin User
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe123!
SEED_DEMO_USER_NAME=Demo User
SEED_DEMO_USER_EMAIL=user@example.com
SEED_DEMO_USER_PASSWORD=ChangeMe123!
